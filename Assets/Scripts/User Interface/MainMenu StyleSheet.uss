Label {
    -unity-font-definition: url("project://database/Assets/Fonts/PixeloidSans.ttf?fileID=12800000&guid=af4cc248e2acb244fbd4033fe3485bb5&type=3#PixeloidSans");
}

.main-root {
    flex-grow: 1;
    justify-content: flex-start;
    align-items: flex-end;
    padding: 40px;
    background-color: transparent;
}

.title-container {
    align-items: flex-end;
    margin-top: 20px;
    margin-right: 30px;
}

.new-badge {
    margin-bottom: -10px;
    scale: 1 1;
    rotate: -12deg;
    font-size: 32px;
    color: rgb(255, 230, 100);
    transition-property: scale;
    transition-duration: 1s;
    transition-timing-function: ease-in-out-cubic;
}

.new-badge-enlarged {
    scale: 1.1 1.1;
}

.title-label {
    font-size: 84px;
    letter-spacing: 2px;
    color: rgb(240, 240, 240);
    -unity-text-generator: standard;
    -unity-font-definition: url("project://database/Assets/Fonts/PixeloidSans-Bold.ttf?fileID=12800000&guid=e9e27104f5b09db42ba201a0fcc31f1b&type=3#PixeloidSans-Bold");
}

.menu-container {
    width: 25%;
    height: 50%;
    margin-top: 5%;
    margin-right: 5%;
    align-items: flex-end;
}

.menu-button {
    width: 100%;
    height: 15%;
    margin-bottom: 5%;
    border-width: 0;
    background-color: transparent;
    background-image: url("project://database/Assets/Textures/Sprites/Grunge%20Brush.png?fileID=21300000&guid=40e952c8dd4ea8f49a010d6119cc13c4&type=3#Grunge Brush");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(149, 25, 25);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Fonts/PixeloidSans.ttf?fileID=12800000&guid=af4cc248e2acb244fbd4033fe3485bb5&type=3#PixeloidSans");
    -unity-text-align: middle-center;
    white-space: normal;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.064s, 0.064s;
    transition-timing-function: ease-in-out-cubic, ease-in-out-cubic;
}

.menu-button:hover {
    scale: 1.05;
    -unity-background-image-tint-color: rgb(178, 29, 29);
}

.menu-button:active {
    scale: 0.98;
}

.fade-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: 0.5s, 0.5s;
}

.fade-overlay-visible {
    opacity: 1;
    visibility: visible;
}

.settings-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: space-between;
    padding: 40px;
    background-color: rgb(20, 20, 20);
}

.hidden {
    display: none;
}

.settings-title {
    font-size: 48px;
    -unity-text-align: upper-center;
}

.settings-back-button {
    width: 150px;
    height: 50px;
    font-size: 18px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 20px;
}

.setting-label {
    font-size: 24px;
    color: rgb(240, 240, 240);
    -unity-font-definition: url("project://database/Assets/Fonts/PixeloidSans.ttf?fileID=12800000&guid=af4cc248e2acb244fbd4033fe3485bb5&type=3#PixeloidSans");
}

.setting-control {
    width: 200px; 
}