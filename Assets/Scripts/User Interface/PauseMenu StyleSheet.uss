/* Creates the dark, semi-transparent background that covers the frozen game */
.pause-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.85); 
    align-items: center;
    justify-content: center;
}

/* The centered container for the buttons */
.pause-menu-box {
    align-items: center;
    width: 40%;
    padding: 40px;
    background-color: rgb(20, 20, 20);
    border-width: 4px;
    border-color: rgb(149, 25, 25);
}

.pause-title {
    font-size: 64px;
    letter-spacing: 2px;
    color: rgb(240, 240, 240);
    margin-bottom: 40px;
    -unity-text-align: upper-center;
    -unity-font-definition: url("project://database/Assets/Fonts/PixeloidSans-Bold.ttf?fileID=12800000&guid=e9e27104f5b09db42ba201a0fcc31f1b&type=3#PixeloidSans-Bold");
}

.pause-button {
    width: 100%;
    height: 60px;
    margin-bottom: 20px;
    border-width: 0;
    background-color: transparent;
    background-image: url("project://database/Assets/Textures/Sprites/Grunge%20Brush.png?fileID=21300000&guid=40e952c8dd4ea8f49a010d6119cc13c4&type=3#Grunge Brush");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(149, 25, 25);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Fonts/PixeloidSans.ttf?fileID=12800000&guid=af4cc248e2acb244fbd4033fe3485bb5&type=3#PixeloidSans");
    -unity-text-align: middle-center;
    transition-property: -unity-background-image-tint-color, scale;
    transition-duration: 0.064s, 0.064s;
    transition-timing-function: ease-in-out-cubic, ease-in-out-cubic;
}

.pause-button:hover {
    scale: 1.05;
    -unity-background-image-tint-color: rgb(178, 29, 29);
}

.pause-button:active {
    scale: 0.98;
}

.hidden {
    display: none;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 15px;
}

.setting-label {
    font-size: 20px;
    color: rgb(240, 240, 240);
    -unity-font-definition: url("project://database/Assets/Fonts/PixeloidSans.ttf?fileID=12800000&guid=af4cc248e2acb244fbd4033fe3485bb5&type=3#PixeloidSans");
}

.setting-control {
    width: 180px;
}

.text {
    -unity-font-definition: url("project://database/Assets/Fonts/PixeloidSans.ttf?fileID=12800000&guid=af4cc248e2acb244fbd4033fe3485bb5&type=3#PixeloidSans");
    color: rgb(153, 153, 153);
    font-size: 16px;
}